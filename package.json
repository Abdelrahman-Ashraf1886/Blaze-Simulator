{
  "name": "blaze-uav",
  "productName": "Blaze UAV",
  "version": "0.1.0",
  "description": "Drone engineering and flight simulation workstation",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "engine:build": "cargo build --release --manifest-path simulation-engine/Cargo.toml",
    "engine:test": "cargo test --workspace --manifest-path simulation-engine/Cargo.toml",
    "dev": "npm run engine:build && electron-vite dev",
    "build": "npm run engine:build && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "npm run engine:build && vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:flight-perf": "node scripts/flight-perf.cjs",
    "profile": "node scripts/profile/profile.cjs",
    "test:all": "npm run engine:test && npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "icon": "node scripts/render-icon.mjs",
    "notices": "node scripts/notices.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win"
  },
  "author": "Blaze UAV contributors",
  "//dependencies": "Only main-process runtime deps belong here; renderer libs are bundled by Vite and live in devDependencies so they are not shipped twice.",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "uplot": "1.6.32",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": false,
    "electron-winstaller@5.4.0": true
  }
}
